---
layout: layouts/base.njk
headerSolid: true
schema: article
---
{#
  Impulsbeiträge und Event-Recaps. Der Fließtext liegt auf einer weißen Lesefläche
  über dem Creme-Grund — Langform bleibt hell, die dunkle Navy-Fläche ist den
  Werte-Blöcken und dem Footer vorbehalten.
#}
<article>
  <header class="article-head">
    <div class="container">
      <a class="btn btn--ghost back-link" href="{{ ('/impulse/recaps/' if isRecap else '/impulse/artikel/') }}">
        ← {{ "Event-Recaps" if isRecap else "Impulsbeiträge" }}
      </a>
      <h1>{{ title }}</h1>
      {% if teaser %}<p class="article-head__teaser">{{ teaser }}</p>{% endif %}
      <p class="article-head__meta">
        <time datetime="{{ date | isoDate }}">{{ date | dateDe }}</time>
        {% if autor %}<span class="sep" aria-hidden="true">·</span>{{ autor }}{% endif %}
        <span class="sep" aria-hidden="true">·</span>{{ content | lesezeit }} Min. Lesezeit
      </p>
    </div>
  </header>

  {% if bild %}
  {%- set masse = bild | bildMasse -%}
  <figure class="article-figure{% if masse and masse.height > masse.width %} article-figure--hoch{% endif %}">
    <div class="container">
      <img src="{{ bild }}" alt="{{ bild_alt }}"{% if masse %} width="{{ masse.width }}" height="{{ masse.height }}"{% endif %}
           fetchpriority="high" decoding="async">
    </div>
  </figure>
  {% endif %}

  <div class="article-body">
    <div class="container">
      <div class="prose">
        {{ content | safe }}
      </div>

      {% if themen %}
      <ul class="tag-list" aria-label="Themen">
        {% for t in themen %}<li class="tag">{{ t }}</li>{% endfor %}
      </ul>
      {% endif %}
    </div>
  </div>
</article>

{% set weitere = (collections.eventRecaps if isRecap else collections.fachartikel) %}
{% if weitere.length > 1 %}
<section class="section list-section">
  <div class="container">
    <span class="eyebrow">Weiterlesen</span>
    <h2 class="section__title">{{ "Andere Recaps" if isRecap else "Weitere Impulsbeiträge" }}</h2>
    <ul class="entry-list">
      {% for entry in weitere | andereEintraege(page.url, 3) %}
        {% include "partials/entry-row.njk" %}
      {% endfor %}
    </ul>
  </div>
</section>
{% endif %}

{% include "partials/join-band.njk" %}
